{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build flipcards",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "*.cpp",
        "-o",
        "flipcards.exe"
      ],
      "options": {
        "cwd": "FlipCards"
      },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
